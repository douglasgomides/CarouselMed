# CarouselMed — variáveis de ambiente
# Copie para .env (local) ou cadastre na Vercel. Nenhum valor real aqui.

# ── Acesso ao painel ────────────────────────────────────────────────
# Contas do time, separadas por vírgula. A senha pode conter ':'.
PANEL_USERS="fulano:senha-dele,equipe:senha-do-time"
# Chave que assina o cookie de sessão. Sem ela, trocar qualquer senha
# derruba as sessões de todo mundo.
SESSION_SECRET=

# Formato antigo, ainda aceito como fallback (um usuário só):
# PANEL_USER=
# PANEL_PASSWORD=

# ── Storage (galeria, designs, exports e templates compartilhados) ───
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=carouselmed

# ── IA ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Calendário editorial ────────────────────────────────────────────
CALENDAR_API_URL=
CALENDAR_API_KEY=

# ── Opcionais ───────────────────────────────────────────────────────
# PORT=3000
# DATA_DIR=              # onde gravar quando não há Supabase
# EXPORT_TIMEOUT_MS=     # teto do Chromium na exportação
# PUPPETEER_EXECUTABLE_PATH=
# POLLINATIONS_TOKEN=
